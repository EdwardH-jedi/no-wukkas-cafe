{
  "name": "no-wukkas-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "First-person 3D café sim set in Surry Hills, Sydney.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --open",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "balance": "node scripts/balance.ts",
    "pace": "node scripts/day2-pace.ts",
    "voices": "node scripts/voices.ts",
    "voices:check": "node scripts/voices-check.ts",
    "voices:estimate": "node scripts/voices-estimate.ts",
    "release:check": "node scripts/voices-check.ts --release && npm run build",
    "voices:audition": "node scripts/voices-audition.ts"
  },
  "dependencies": {
    "@fontsource/bowlby-one": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
